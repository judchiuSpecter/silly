-- A configured photo source: local device, a cloud account, Takeout, or NAS archive.
CREATE TABLE Source (
    id            TEXT NOT NULL PRIMARY KEY,
    type          TEXT NOT NULL,           -- LOCAL, GOOGLE_DRIVE, MEGA, ONEDRIVE, TAKEOUT, NAS_ARCHIVE
    displayName   TEXT NOT NULL,
    enabled       INTEGER NOT NULL DEFAULT 1,
    isUploadTarget INTEGER NOT NULL DEFAULT 0, -- exactly one source may receive Local Photo Sync
    isArchiveTarget INTEGER NOT NULL DEFAULT 0, -- legacy column name: the one Move destination
    isVisible      INTEGER NOT NULL DEFAULT 1, -- user can hide a source from the timeline
    -- Opaque, source-specific config (JSON). Credentials are stored separately/encrypted.
    configJson    TEXT NOT NULL DEFAULT '{}',
    lastSyncedAt  INTEGER,                  -- epoch millis of last successful sync, null if never
    sortOrder     INTEGER NOT NULL DEFAULT 0,
    -- Set when the last sync attempt failed (e.g. account blocked, host
    -- unreachable). Non-null means the Sources screen shows an alert and the
    -- periodic/background sync skips this source until the user retries it by
    -- hand, so one broken account cannot keep retrying forever in the background.
    lastSyncError TEXT
);

selectAll:
SELECT * FROM Source ORDER BY sortOrder, displayName;

selectEnabled:
SELECT * FROM Source WHERE enabled = 1 ORDER BY sortOrder, displayName;

selectById:
SELECT * FROM Source WHERE id = ?;

selectUploadTarget:
SELECT * FROM Source WHERE isUploadTarget = 1 LIMIT 1;

selectMoveTarget:
SELECT * FROM Source WHERE isArchiveTarget = 1 LIMIT 1;

-- Split into insert + update rather than SQLite's `ON CONFLICT ... DO UPDATE`:
-- some Android devices ship an SQLite build old enough to reject upsert syntax
-- outright. `MediaRepository.upsertSource` runs both in a transaction so
-- callers still see one logical upsert.
insertIgnoringExisting:
INSERT OR IGNORE INTO Source(id, type, displayName, enabled, isUploadTarget, configJson, lastSyncedAt, sortOrder, lastSyncError)
VALUES (:id, :type, :displayName, :enabled, :isUploadTarget, :configJson, :lastSyncedAt, :sortOrder, :lastSyncError);

updateExisting:
UPDATE Source SET
    type = :type,
    displayName = :displayName,
    enabled = :enabled,
    isUploadTarget = :isUploadTarget,
    configJson = :configJson,
    lastSyncedAt = :lastSyncedAt,
    sortOrder = :sortOrder,
    lastSyncError = :lastSyncError
WHERE id = :id;

-- Called after every sync attempt: null clears a previous alert on success.
setSyncError:
UPDATE Source SET lastSyncError = ? WHERE id = ?;

-- Only one upload target at a time: clear the flag everywhere, then the caller sets it on one.
clearAllUploadTargets:
UPDATE Source SET isUploadTarget = 0;

-- Clears only one source, used when the current target is disconnected.
clearUploadTarget:
UPDATE Source SET isUploadTarget = 0 WHERE id = ?;

-- Same single-slot model for the Move destination. Kept out of `upsert` so
-- re-linking an account cannot silently move it. The SQL column keeps its old
-- name so existing installs need no destructive migration.
clearAllMoveTargets:
UPDATE Source SET isArchiveTarget = 0;

setMoveTarget:
UPDATE Source SET isArchiveTarget = 1 WHERE id = ?;

clearMoveTarget:
UPDATE Source SET isArchiveTarget = 0 WHERE id = ?;

-- Per-source timeline visibility. Not part of `upsert`, so re-linking preserves it.
setSourceVisible:
UPDATE Source SET isVisible = ? WHERE id = ?;

setLastSynced:
UPDATE Source SET lastSyncedAt = ? WHERE id = ?;

delete:
DELETE FROM Source WHERE id = ?;
